# Vercel / local app reads
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Write access: use in GitHub Actions. Optional on Vercel unless using /api/refresh.
SUPABASE_SERVICE_ROLE_KEY=

# Optional manual refresh endpoint protection
CRON_SECRET=change-me

# Optional Telegram alerts from GitHub Actions scraper
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
